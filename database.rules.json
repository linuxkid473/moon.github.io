{
  "rules": {
    ".read": false,
    ".write": false,

    "players": {
      ".read": true,
      ".indexOn": ["username"],
      "$playerId": {
        ".write": true,
        "photoURL": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60000)" }
      }
    },
    "presence": { ".read": true, "$id": { ".write": true } },
    "stats": { ".read": true, ".write": true },
    "rooms": { ".read": true, ".write": true },
    "comments": { ".read": true, ".write": true },
    "recommendations": {
      ".read": "auth != null && (auth.token.email === 'ultrabsd@moongames.app' || (auth.token.email === 'nathan.vihaan@gmail.com' && auth.token.email_verified === true))",
      ".indexOn": ["ts"],
      "$id": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && (auth.token.email === 'ultrabsd@moongames.app' || (auth.token.email === 'nathan.vihaan@gmail.com' && auth.token.email_verified === true)))",
        ".validate": "newData.hasChildren(['text', 'ts']) && (newData.child('ts').val() === now || (data.exists() && newData.child('ts').val() === data.child('ts').val()))",
        "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 1800" },
        "ts": { ".validate": "newData.isNumber()" },
        "done": { ".validate": "newData.isBoolean() && (auth != null && (auth.token.email === 'ultrabsd@moongames.app' || (auth.token.email === 'nathan.vihaan@gmail.com' && auth.token.email_verified === true)))" },
        "$other": { ".validate": false }
      }
    },
    "site": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'ultrabsd@moongames.app' || (auth.token.email === 'nathan.vihaan@gmail.com' && auth.token.email_verified === true))",
      "announcement": {
        ".validate": "newData.hasChildren(['text', 'enabled'])",
        "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "enabled": { ".validate": "newData.isBoolean()" },
        "ts": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      },
      "recsEnabled": { ".validate": "newData.isBoolean()" },
      "$other": { ".validate": false }
    },
    "messages": { ".read": true, ".write": true, ".indexOn": ["timestamp"] },
    "typing": { ".read": true, "$id": { ".write": true } },

    "dmMeta": {
      "$conversationId": {
        ".read": "auth != null && $conversationId.contains(auth.uid)",
        ".write": "auth != null && $conversationId.contains(auth.uid)",
        "participants": {
          ".validate": "newData.hasChild(auth.uid) && newData.child(auth.uid).val() === true"
        }
      }
    },

    "dmMessages": {
      "$conversationId": {
        ".read": "auth != null && $conversationId.contains(auth.uid)",
        ".indexOn": ["timestamp"],
        "$messageId": {
          ".write": "auth != null && $conversationId.contains(auth.uid) && ((!data.exists() && newData.exists()) || (data.exists() && data.child('senderId').val() === auth.uid && !newData.exists()))",
          ".validate": "newData.child('senderId').val() === auth.uid && newData.hasChild('timestamp') && (newData.hasChild('text') || newData.hasChild('gifUrl')) && (!newData.hasChild('text') || (newData.child('text').isString() && newData.child('text').val().length <= 2000))"
        }
      }
    },

    "dmInbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$conversationId": {
          ".read": "auth != null && $conversationId.contains(auth.uid) && $conversationId.contains($uid)",
          ".write": "auth != null && $conversationId.contains(auth.uid) && $conversationId.contains($uid)",
          "otherUid": { ".validate": "newData.isString()" },
          "otherUsername": { ".validate": "newData.isString() && newData.val().length <= 40" },
          "otherAvatarEmoji": { ".validate": "newData.isString()" },
          "otherAvatarColor": { ".validate": "newData.isString()" },
          "unreadCount": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "updatedAt": { ".validate": true },
          "lastMessage": {
            "text": { ".validate": "newData.isString() && newData.val().length <= 2000" },
            "gifUrl": { ".validate": "newData.isString()" },
            "senderId": { ".validate": "newData.isString()" },
            "timestamp": { ".validate": true }
          },
          "$other": { ".validate": false }
        }
      }
    },

    "dmTyping": {
      "$conversationId": {
        ".read": "auth != null && $conversationId.contains(auth.uid)",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && $conversationId.contains(auth.uid) && $conversationId.contains($uid)",
          ".validate": "newData.isNumber()"
        }
      }
    }
  }
}
